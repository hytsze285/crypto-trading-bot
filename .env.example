# OKX API credentials (keep secret – never commit your real .env)
OKX_API_KEY=
OKX_SECRET_KEY=
OKX_PASSPHRASE=

# Set to "true" to use the OKX sandbox / paper-trading endpoints
USE_SIMULATED_TRADING=true

# The instrument the bot is allowed to trade
TRADING_PAIR=ROBO-USDT

# Starting equity used for position-sizing calculations
INITIAL_EQUITY=1000

# Operating mode: monitor | simulated_trade | live_trade
RUN_MODE=monitor

# -----------------------------------------------------------------------
# Strategy parameters
# -----------------------------------------------------------------------
TREND_FAST_MA=20
TREND_SLOW_MA=60
BREAKOUT_LOOKBACK=20
VOLUME_LOOKBACK=20
VOLUME_MULTIPLIER=1.5

STOP_LOSS_PCT=0.012
TAKE_PROFIT_1_PCT=0.02
TAKE_PROFIT_2_PCT=0.04
MAX_HOLDING_MINUTES=30

RISK_PER_TRADE_PCT=0.005
MAX_POSITION_NOTIONAL_PCT=0.03
MIN_ORDER_NOTIONAL=5.0

MAX_DAILY_LOSS_PCT=0.02
MAX_CONSECUTIVE_LOSSES=3
MAX_TRADES_PER_DAY=5
COOLDOWN_MINUTES=10

# -----------------------------------------------------------------------
# Live-trading safety gates
# IMPORTANT: Real money will NOT be risked unless ENABLE_LIVE_TRADING=true.
# Leave this false until you have verified API keys, instrument rules,
# and risk parameters in simulated mode.
# -----------------------------------------------------------------------
ENABLE_LIVE_TRADING=false
ALLOWED_INST_ID=ROBO-USDT
OKX_HTTP_TIMEOUT=10
OKX_ORDER_EXP_WINDOW_MS=3000

# -----------------------------------------------------------------------
# Logging
# -----------------------------------------------------------------------
LOG_LEVEL=INFO
